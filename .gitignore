mlb_transformer.pkl

# health_model_v2.pkl is 2.5MB — tracked in git so CI/CD can commit it back
# Do NOT add health_model_v2.pkl here

# Version directories (versioned model copies — ignored, only latest tracked)
models/versions/
retraining/models/

# Generated Patient Medical PDF Prescriptions & Exported Data Spreadsheets
reports/*.pdf
reports/
exports/*
backend/reports/*
backend/exports/*
!exports/.gitkeep
!backend/exports/.gitkeep

