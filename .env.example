# =========================================================================
# MediOps Platform Configuration Template
# Copy this file to '.env' and populate with your credentials.
# =========================================================================

# Groq Cloud API Key for AI diagnostic insights (Llama 3.3 model)
GROQ_API_KEY=your_groq_api_key_here

# Microservices Communication Routing (AI prediction endpoint)
AI_SERVICE_URL=http://ai-service:5000

# =========================================================================
# GitHub CI/CD — Automated ML Retraining Pipeline (Option 2)
# Required to trigger GitHub Actions from the Admin Panel
# =========================================================================

# Your GitHub Personal Access Token (PAT)
# How to generate: GitHub → Settings → Developer Settings → Personal Access Tokens → Fine-grained
# Required scopes: Actions (read/write), Contents (read/write)
GITHUB_TOKEN=your_github_personal_access_token_here

# Your GitHub repository in "owner/repo" format
GITHUB_REPO=Stalin1239/AI-medicine-recommendation-system

# Branch to trigger the pipeline on (default: main)
GITHUB_BRANCH=main
