[Unit]
Description=Gunicorn daemon for MediOps FastAPI Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/mediops
Environment="PATH=/var/www/mediops/venv/bin"
EnvironmentFile=/var/www/mediops/.env
# We use uvicorn workers directly or via gunicorn. For simplicity and stability:
ExecStart=/var/www/mediops/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2

# Auto-restart if it crashes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
